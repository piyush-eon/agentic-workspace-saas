# Copy to .env and fill in. Never commit the real .env.

# Clerk (https://dashboard.clerk.com): API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Supabase (https://supabase.com/dashboard): Project Settings > Database > Connect
# Pooled connection (port 6543) for the app at runtime
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) for Prisma migrations
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase: Project Settings > API (used for real-time doc collaboration)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Gemini (https://aistudio.google.com/apikey): powers the agent
GOOGLE_GENERATIVE_AI_API_KEY=

# Canvas sync server (the tldraw-sync/ Cloudflare Worker, deployed free with `npm run deploy` there).
# Leave empty to use tldraw's public demo server instead.
NEXT_PUBLIC_TLDRAW_SYNC_URL=

# tldraw (https://tldraw.dev): optional on localhost; required in production (the canvas is hidden without a valid key for your domain)
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=
